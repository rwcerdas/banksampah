# ============================================================
# Konfigurasi Environment EcoBank
# Salin file ini: cp .env.example .env  lalu sesuaikan nilainya
# ============================================================

# Rahasia JWT — WAJIB diganti string acak yang kuat (production)
JWT_SECRET=change-me-to-a-secure-random-string

# Opsional: kunci Gemini untuk fitur AI Insight di laporan
GEMINI_API_KEY=

# Judul aplikasi (tampil di UI / PWA)
VITE_APP_TITLE=EcoBank

# --- Development (docker compose.yml) ---
# Browser di host memanggil API lewat port yang di-publish
VITE_API_BASE_URL=http://localhost:3001

# MongoDB dari HOST (script seed/create-admin saat compose lokal jalan)
MONGO_URI=mongodb://root:example@localhost:27018/ecobank?authSource=admin

# Kredensial MongoDB (dev & prod)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

# ============================================================
# Production (docker-compose.prod.yml + scripts/deploy.sh)
# ============================================================
# DOMAIN dan SSL_EMAIL dipakai deploy.sh untuk nginx + Let's Encrypt
# DOMAIN=banksampah.contoh.id
# SSL_EMAIL=admin@contoh.id
#
# Di production, kosongkan VITE_API_BASE_URL agar API same-origin:
#   https://domain-anda/api/...  (proxy lewat nginx frontend)
# VITE_API_BASE_URL=
#
# Ganti MONGO_INITDB_ROOT_PASSWORD dengan password kuat.
# Backend di dalam Docker memakai host "mongodb" (otomatis di compose prod).
