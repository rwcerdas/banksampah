# EcoBank Environment Configuration
# Port EcoBank (hindari bentrok dengan SatuData: 5173, 3000, 27017)

JWT_SECRET=change-me-to-a-secure-random-string
GEMINI_API_KEY=

# Frontend dev (browser → API di host)
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_TITLE=EcoBank

# MongoDB — untuk script di HOST (create-admin, seed) saat docker compose jalan
MONGO_URI=mongodb://root:example@localhost:27018/ecobank?authSource=admin

# MongoDB — untuk backend DI DALAM docker-compose (override otomatis di compose)
# MONGO_URI=mongodb://root:example@mongodb:27017/ecobank?authSource=admin

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
